 The `person_departed` fact preserves only the identity/reporting/handoff attribution needed to refuse reuse and read retained organizational history. Completed removal deletes the live person, incarnations, private message index, focus and current participation, while keeping shared messages, assignments/outcomes, links, audience chronology and accounting. Explicit private fact and command payloads are redacted rather than discarding shared history. Pending cleanup owns its process/file journal across restart, including rejected writing processes observed after permanent admission closes; private file pointers are cleared after cleanup. Legacy retirement/rehire events remain historical facts, not a reactivation surface.
 
diff --git a/components/session-state/tests/channel-membership.test.ts b/components/session-state/tests/channel-membership.test.ts
new file mode 100644
index 00000000..8ed884f4
--- /dev/null
+++ b/components/session-state/tests/channel-membership.test.ts
@@ -0,0 +1,187 @@
+import { existsSync } from "node:fs";
+import { afterAll, beforeAll, expect, test, vi } from "vitest";
+import type { Command } from "../src/protocol.js";
+import type { ThreadKind } from "../src/threads.js";
+import {
+	fakeBridge,
+	query,
+	runtimePid,
+	sendCommand,
+	standInProcess,
+	startRuntime,
+	stopRuntime,
+	tempStateDir,
+} from "./helpers.js";
+
+const state = tempStateDir();
+const stand = standInProcess();
+const other = standInProcess();
+const channel = "team:lead";
+
+beforeAll(async () => {
+	await startRuntime(state.socketPath);
+	await fakeBridge(state.socketPath, "lead", stand.pid, stand.startedAt, {
+		session: { name: "Lead" },
+		facts: { manages: true },
+	});
+	await fakeBridge(state.socketPath, "other", other.pid, other.startedAt, {
+		session: { name: "Other" },
+		facts: { manages: true },
+	});
+	await vi.waitFor(() => expect(query(state.dbPath, "select id from threads where id = ?", channel)).toHaveLength(1), {
+		timeout: 10000,
+	});
+});
+afterAll(async () => {
+	stand.child.kill();
+	other.child.kill();
+	await stopRuntime(state);
+});
+
+const sent = async (who: string, command: Command, commandId?: string) => {
+	const receipt = (await sendCommand(state.socketPath, who, command, commandId ? { commandId } : {})).at(-1);
+	if (!receipt) throw new Error(`no receipt for ${command.kind}`);
+	return receipt;
+};
+const membership = () =>
+	query<{ delivery: string; read_up_to: number; invited: number }>(
+		state.dbPath,
+		"select delivery, read_up_to, invited from thread_participants where thread_id = ? and participant = 'operator'",
+		channel,
+	);
+const audience = (type: string, thread = channel) =>
+	query<{ at: number }>(
+		state.dbPath,
+		"select at from events where session_id = 'operator' and type = ? and json_extract(data, '$.thread') = ? order by seq",
+		type,
+		thread,
+	);
+async function restart() {
+	const pid = runtimePid(state.pidPath)!;
+	process.kill(pid, "SIGTERM");
+	await vi.waitFor(() => expect(existsSync(state.socketPath)).toBe(false), { timeout: 10000 });
+	await startRuntime(state.socketPath);
+}
+
+test("the operator joins and leaves a team channel, and reconciliation keeps that choice", async () => {
+	expect((await sent("operator", { kind: "thread_post", thread: channel, body: "Before I join." })).reason).toBe(
+		"you are not in this thread",
+	);
+	await sent("lead", { kind: "thread_post", thread: channel, body: "History before the operator joins." });
+	const seq = query<{ seq: number }>(
+		state.dbPath,
+		"select max(seq) as seq from thread_messages where thread_id = ?",
+		channel,
+	)[0].seq;
+
+	expect(await sent("operator", { kind: "channel_membership", thread: channel, joined: true }, "join-once")).toEqual({
+		stage: "applied",
+	});
+	expect(membership()).toEqual([{ delivery: "pull", read_up_to: 0, invited: 1 }]);
+	expect(audience("thread_joined")).toHaveLength(1);
+
+	await sent("operator", { kind: "thread_read", thread: channel, seq });
+	expect(await sent("operator", { kind: "channel_membership", thread: channel, joined: true })).toEqual({
+		stage: "applied",
+	});
+	expect(membership()).toEqual([{ delivery: "pull", read_up_to: seq, invited: 1 }]);
+	expect(audience("thread_joined")).toHaveLength(1);
+
+	expect(await sent("operator", { kind: "thread_post", thread: channel, body: "I will watch this channel." })).toEqual({
+		stage: "applied",
+	});
+
+	const cursor = membership()[0].read_up_to;
+	await restart();
+	expect(membership()).toEqual([{ delivery: "pull", read_up_to: cursor, invited: 1 }]);
+	expect(audience("thread_joined")).toHaveLength(1);
+	expect(audience("thread_left")).toEqual([]);
+
+	expect(await sent("operator", { kind: "channel_membership", thread: channel, joined: false }, "leave-once")).toEqual({
+		stage: "applied",
+	});
+	expect(membership()).toEqual([]);
+	expect(audience("thread_left")).toHaveLength(1);
+	expect(await sent("operator", { kind: "channel_membership", thread: channel, joined: false })).toEqual({
+		stage: "applied",
+	});
+	expect(audience("thread_left")).toHaveLength(1);
+	expect((await sent("operator", { kind: "thread_post", thread: channel, body: "After I leave." })).reason).toBe(
+		"you are not in this thread",
+	);
+
+	await restart();
+	expect(membership()).toEqual([]);
+	expect(audience("thread_joined")).toHaveLength(1);
+	expect(audience("thread_left")).toHaveLength(1);
+	expect(await sent("operator", { kind: "channel_membership", thread: channel, joined: true }, "join-once")).toEqual({
+		stage: "applied",
+	});
+	expect(membership()).toEqual([]);
+}, 40000);
+
+test("membership is refused for a person and for any thread that is not a team channel", async () => {
+	const make = async (thread: string, threadKind: ThreadKind) => {
+		expect(
+			(
+				await sent("lead", {
+					kind: "thread_post",
+					thread,
+					threadKind,
+					subject: thread,
+					to: ["other"],
+					body: "Private.",
+				})
+			)?.stage,
+		).toBe("applied");
+	};
+	await make("t-mail", "mail");
+	await make("t-meeting", "meeting");
+	await make("t-task", "task");
+	await make("t-escalation", "escalation");
+	for (const thread of ["t-mail", "t-meeting", "t-task", "t-escalation", "team:missing"]) {
+		expect((await sent("operator", { kind: "channel_membership", thread, joined: true })).reason).toBe(
+			"no team channel with that id",
+		);
+		expect(
+			query(state.dbPath, "select 1 from thread_participants where thread_id = ? and participant = 'operator'", thread),
+		).toEqual([]);
+	}
+	expect(
+		(
+			await sent("operator", {
+				kind: "channel_membership",
+				thread: "",
+				joined: true,
+			})
+		).reason,
+	).toBe("channel membership needs a thread and whether to join");
+	expect(
+		(
+			await sent("operator", {
+				kind: "channel_membership",
+				thread: channel,
+				joined: "yes" as unknown as boolean,
+			})
+		).reason,
+	).toBe("channel membership needs a thread and whether to join");
+	expect((await sent("other", { kind: "channel_membership", thread: channel, joined: true })).reason).toBe(
+		"only the operator can join or leave a channel this way",
+	);
+	expect(
+		query(
+			state.dbPath,
+			"select participant from thread_participants where thread_id = ? and participant = 'other'",
+			channel,
+		),
+	).toEqual([]);
+	expect(await sent("operator", { kind: "channel_membership", thread: "team:other", joined: true })).toEqual({
+		stage: "applied",
+	});
+	expect(
+		query(
+			state.dbPath,
+			"select delivery, invited from thread_participants where thread_id = 'team:other' and participant = 'operator'",
+		),
+	).toEqual([{ delivery: "pull", invited: 1 }]);
+});
diff --git a/components/session-state/tests/channel-membership-recovery.test.ts b/components/session-state/tests/channel-membership-recovery.test.ts
new file mode 100644
index 00000000..40b12ebd
--- /dev/null
+++ b/components/session-state/tests/channel-membership-recovery.test.ts
@@ -0,0 +1,114 @@
+import { mkdirSync } from "node:fs";
+import { DatabaseSync } from "node:sqlite";
+import { afterAll, beforeAll, expect, test } from "vitest";
+import { migrate } from "../src/schema.js";
+import { query, startRuntime, stopRuntime, tempStateDir } from "./helpers.js";
+
+const state = tempStateDir();
+
+beforeAll(async () => {
+	// A stopped runtime, with accepted membership commands at both crash boundaries. Only this fixture writes the
+	// database; the runtime then reconciles channels and replays those commands.
+	mkdirSync(state.stateDir, { recursive: true });
+	const db = new DatabaseSync(state.dbPath);
+	migrate(db);
+	for (const id of ["kept", "pending", "left", "both"])
+		db.prepare(
+			"insert into sessions (id, kind, cwd, run_state, generation, source, updated_at) values (?, 'root', '/tmp', 'idle', 1, 'fixture', 0)",
+		).run(id);
+	const thread = db.prepare(
+		"insert into threads (id, kind, subject, created_by, created_at) values (?, 'channel', ?, ?, 1)",
+	);
+	const member = db.prepare(
+		"insert into thread_participants (thread_id, participant, delivery, read_up_to, joined_at, invited) values (?, 'operator', 'pull', ?, 10, 1)",
+	);
+	const command = db.prepare(
+		"insert into commands (command_id, session_id, kind, command, stage, created_at, updated_at) values (?, 'operator', 'channel_membership', ?, 'accepted', ?, ?)",
+	);
+	const event = db.prepare(
+		"insert into events (at, source, session_id, type, data) values (?, 'runtime', 'operator', ?, ?)",
+	);
+	thread.run("team:kept", "Kept", "kept");
+	member.run("team:kept", 4);
+	event.run(10, "thread_joined", JSON.stringify({ thread: "team:kept" }));
+	command.run("join-kept", JSON.stringify({ kind: "channel_membership", thread: "team:kept", joined: true }), 20, 20);
+
+	thread.run("team:pending", "Pending", "pending");
+	command.run(
+		"join-pending",
+		JSON.stringify({ kind: "channel_membership", thread: "team:pending", joined: true }),
+		30,
+		30,
+	);
+
+	thread.run("team:left", "Left", "left");
+	member.run("team:left", 2);
+	event.run(10, "thread_joined", JSON.stringify({ thread: "team:left" }));
+	command.run(
+		"leave-pending",
+		JSON.stringify({ kind: "channel_membership", thread: "team:left", joined: false }),
+		40,
+		40,
+	);
+
+	thread.run("team:gone", "Gone", "kept");
+	event.run(10, "thread_joined", JSON.stringify({ thread: "team:gone" }));
+	event.run(15, "thread_left", JSON.stringify({ thread: "team:gone" }));
+	command.run("leave-done", JSON.stringify({ kind: "channel_membership", thread: "team:gone", joined: false }), 50, 50);
+
+	thread.run("team:both", "Both", "both");
+	command.run("join-both", JSON.stringify({ kind: "channel_membership", thread: "team:both", joined: true }), 70, 70);
+	command.run("leave-both", JSON.stringify({ kind: "channel_membership", thread: "team:both", joined: false }), 80, 80);
+
+	command.run("join-mail", JSON.stringify({ kind: "channel_membership", thread: "t-mail", joined: true }), 60, 60);
+	db.exec(
+		"insert into threads (id, kind, subject, created_by, created_at) values ('t-mail', 'mail', 'Mail', 'kept', 1)",
+	);
+	db.close();
+	await startRuntime(state.socketPath);
+});
+afterAll(() => stopRuntime(state));
+
+const row = (thread: string) =>
+	query<{ delivery: string; read_up_to: number; invited: number }>(
+		state.dbPath,
+		"select delivery, read_up_to, invited from thread_participants where thread_id = ? and participant = 'operator'",
+		thread,
+	);
+const events = (thread: string, type: string) =>
+	query<{ at: number }>(
+		state.dbPath,
+		"select at from events where session_id = 'operator' and type = ? and json_extract(data, '$.thread') = ? order by seq",
+		type,
+		thread,
+	);
+
+test("startup finishes accepted membership without resetting a committed cursor or repeating a committed leave", () => {
+	expect(
+		query(
+			state.dbPath,
+			"select command_id, stage, reason from commands where kind = 'channel_membership' order by created_at",
+		),
+	).toEqual([
+		{ command_id: "join-kept", stage: "applied", reason: null },
+		{ command_id: "join-pending", stage: "applied", reason: null },
+		{ command_id: "leave-pending", stage: "applied", reason: null },
+		{ command_id: "leave-done", stage: "applied", reason: null },
+		{ command_id: "join-mail", stage: "failed", reason: "no team channel with that id" },
+		{ command_id: "join-both", stage: "applied", reason: null },
+		{ command_id: "leave-both", stage: "applied", reason: null },
+	]);
+	expect(row("team:kept")).toEqual([{ delivery: "pull", read_up_to: 4, invited: 1 }]);
+	expect(events("team:kept", "thread_joined")).toEqual([{ at: 10 }]);
+	expect(events("team:kept", "thread_left")).toEqual([]);
+	expect(row("team:pending")).toEqual([{ delivery: "pull", read_up_to: 0, invited: 1 }]);
+	expect(events("team:pending", "thread_joined")).toEqual([{ at: 30 }]);
+	expect(row("team:left")).toEqual([]);
+	expect(events("team:left", "thread_left")).toEqual([{ at: 40 }]);
+	expect(row("team:gone")).toEqual([]);
+	expect(events("team:gone", "thread_left")).toEqual([{ at: 15 }]);
+	expect(row("t-mail")).toEqual([]);
+	expect(row("team:both")).toEqual([]);
+	expect(events("team:both", "thread_joined")).toEqual([{ at: 70 }]);
+	expect(events("team:both", "thread_left")).toEqual([{ at: 80 }]);
+});
diff --git a/components/session-state/tests/hire-date.test.ts b/components/session-state/tests/hire-date.test.ts
new file mode 100644
index 00000000..5dd859bb
--- /dev/null
+++ b/components/session-state/tests/hire-date.test.ts
@@ -0,0 +1,218 @@
+import { existsSync, mkdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { afterEach, expect, test, vi } from "vitest";
+import { sendCommand } from "../src/client.js";
+import { openPeerProgram, type PeerProgram } from "../src/program-client.js";
+import { migrate } from "../src/schema.js";
+import { fakeBridge, query, runtimePid, standInProcess, startRuntime, stopRuntime, tempStateDir } from "./helpers.js";
+
+const fixture = new URL("../../../tests/fixtures/peer-pi.mjs", import.meta.url).pathname;
+const processes: ReturnType<typeof standInProcess>[] = [];
+let programs: PeerProgram[] = [];
+
+afterEach(async () => {
+	for (const program of programs) await program.close().catch(() => undefined);
+	programs = [];
+	for (const process of processes) process.child.kill();
+	processes.length = 0;
+	vi.unstubAllEnvs();
+});
+
+function hireCommand(manager: string, cwd: string) {
+	return {
+		kind: "start" as const,
+		cwd,
+		reportsTo: manager,
+		role: "repository-archaeologist",
+		name: "New Hire",
+		goal: { text: "Record when this hire connects.", by: manager, title: "Hire date" },
+	};
+}
+
+test("startup does not date an already applied hire or a person with no hire", async () => {
+	const state = tempStateDir();
+	mkdirSync(state.stateDir, { recursive: true });
+	const db = new DatabaseSync(state.dbPath);
+	migrate(db);
+	db.prepare(
+		"insert into sessions (id, kind, cwd, run_state, generation, source, updated_at, role, hired_at) values ('old-hire', 'root', '/tmp', 'idle', 1, 'fixture', 1, 'repository-archaeologist', null)",
+	).run();
+	db.prepare(
+		"insert into sessions (id, kind, cwd, run_state, generation, source, updated_at, hired_at) values ('visitor', 'root', '/tmp', 'idle', 1, 'fixture', 1, null)",
+	).run();
+	db.prepare(
+		"insert into sessions (id, kind, cwd, run_state, generation, source, updated_at, hired_at) values ('kept', 'root', '/tmp', 'idle', 1, 'fixture', 1, 5)",
+	).run();
+	db.prepare(
+		"insert into incarnations (session_id, generation, pid, process_started_at, process_state, started_at, ended_at, source, updated_at) values ('old-hire', 1, 1, 1, 'exited', 20, 21, 'fixture', 21)",
+	).run();
+	db.prepare(
+		"insert into commands (command_id, session_id, kind, command, stage, created_at, updated_at) values ('old-start', 'old-hire', 'start', ?, 'applied', 10, 20)",
+	).run(
+		JSON.stringify({
+			kind: "start",
+			role: "repository-archaeologist",
+			goal: { text: "An old hire.", by: "someone", title: "Old" },
+		}),
+	);
+	db.close();
+	try {
+		await startRuntime(state.socketPath);
+		expect(query(state.dbPath, "select id, hired_at from sessions order by id")).toEqual([
+			{ id: "kept", hired_at: 5 },
+			{ id: "old-hire", hired_at: null },
+			{ id: "visitor", hired_at: null },
+		]);
+	} finally {
+		await stopRuntime(state);
+	}
+});
+
+test("a connecting hire is dated once, and call-in, transfer, and restart keep that date", async () => {
+	const state = tempStateDir();
+	const bin = join(state.agentDir, "bin");
+	mkdirSync(bin);
+	writeFileSync(join(bin, "pi"), `#!/bin/sh\nexec '${process.execPath}' '${fixture}' "$@"\n`, { mode: 0o700 });
+	vi.stubEnv("PATH", `${bin}:${process.env.PATH}`);
+	const manager = standInProcess();
+	const visitor = standInProcess();
+	const lead = standInProcess();
+	processes.push(manager, visitor, lead);
+	await startRuntime(state.socketPath);
+	try {
+		await fakeBridge(state.socketPath, "manager", manager.pid, manager.startedAt, {
+			session: { cwd: state.agentDir, name: "Manager" },
+			facts: { manages: true },
+		});
+		await vi.waitFor(() => expect(query(state.dbPath, "select id from sessions where id = 'manager'")).toHaveLength(1));
+		const hired = await sendCommand("new-hire", hireCommand("manager", state.agentDir), { commandId: "hire-command" });
+		expect(hired.stage, hired.reason).toBe("applied");
+		const dated = query<{ hired_at: number; started_at: number }>(
+			state.dbPath,
+			"select s.hired_at, min(i.started_at) as started_at from sessions s join incarnations i on i.session_id = s.id where s.id = 'new-hire'",
+		)[0];
+		expect(dated.hired_at).toBe(dated.started_at);
+
+		await fakeBridge(state.socketPath, "visitor", visitor.pid, visitor.startedAt, {
+			session: { cwd: state.agentDir, name: "Visitor" },
+		});
+		await vi.waitFor(() =>
+			expect(query(state.dbPath, "select hired_at from sessions where id = 'visitor'")).toEqual([{ hired_at: null }]),
+		);
+		const plain = await sendCommand("plain", {
+			kind: "start",
+			cwd: state.agentDir,
+			reportsTo: "manager",
+			goal: { text: "No role, so this is not a hire.", by: "manager", title: "Unroled" },
+		});
+		expect(plain.stage, plain.reason).toBe("applied");
+		expect(query(state.dbPath, "select hired_at from sessions where id = 'plain'")).toEqual([{ hired_at: null }]);
+
+		const repeat = await sendCommand("new-hire", hireCommand("manager", state.agentDir), { commandId: "hire-command" });
+		expect(repeat.stage).toBe("applied");
+		expect(query(state.dbPath, "select hired_at from sessions where id = 'new-hire'")).toEqual([
+			{ hired_at: dated.hired_at },
+		]);
+
+		const pid = query<{ pid: number }>(
+			state.dbPath,
+			"select pid from incarnations where session_id = 'new-hire' and ended_at is null",
+		)[0].pid;
+		process.kill(pid, "SIGTERM");
+		await vi.waitFor(() =>
+			expect(
+				query(state.dbPath, "select ended_at from incarnations where session_id = 'new-hire' and pid = ?", pid)[0]
+					.ended_at,
+			).not.toBeNull(),
+		);
+		const called = await sendCommand("new-hire", { kind: "start", reportsTo: "manager" });
+		expect(called.stage, called.reason).toBe("applied");
+		expect(query(state.dbPath, "select hired_at from sessions where id = 'new-hire'")).toEqual([
+			{ hired_at: dated.hired_at },
+		]);
+
+		await fakeBridge(state.socketPath, "lead", lead.pid, lead.startedAt, {
+			session: { cwd: state.agentDir, name: "Lead" },
+			facts: { reportsTo: "manager", manages: true },
+		});
+		await vi.waitFor(() =>
+			expect(query(state.dbPath, "select reports_to from sessions where id = 'lead'")).toEqual([
+				{ reports_to: "manager" },
+			]),
+		);
+		const moved = await sendCommand("new-hire", { kind: "transfer", manager: "lead", by: "manager" });
+		expect(moved.stage, moved.reason).toBe("applied");
+		expect(query(state.dbPath, "select reports_to, hired_at from sessions where id = 'new-hire'")).toEqual([
+			{ reports_to: "lead", hired_at: dated.hired_at },
+		]);
+
+		const runtime = runtimePid(state.pidPath)!;
+		process.kill(runtime, "SIGTERM");
+		await vi.waitFor(() => expect(existsSync(state.socketPath)).toBe(false));
+		await startRuntime(state.socketPath);
+		expect(query(state.dbPath, "select hired_at from sessions where id = 'new-hire'")).toEqual([
+			{ hired_at: dated.hired_at },
+		]);
+		expect(query(state.dbPath, "select hired_at from sessions where id = 'visitor'")).toEqual([{ hired_at: null }]);
+	} finally {
+		await stopRuntime(state);
+	}
+}, 40000);
