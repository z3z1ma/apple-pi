{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!components/browser-pages/dist",
      "!apps/agent-workplace/dist",
      "!components/tmux-sessions/notch/web/assets"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 50
          }
        }
      },
      "suspicious": {
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noExplicitAny": "off",
        "noControlCharactersInRegex": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["*.json", "**/*.json"],
      "formatter": {
        "indentStyle": "space",
        "indentWidth": 2
      }
    },
    {
      "includes": ["**/*.hot.ts"],
      "plugins": ["./.pi/rules/hot-bounded-io.grit"]
    },
    {
      "includes": ["apps/agent-workplace/web/workplace*.tsx"],
      "plugins": ["./.pi/rules/no-native-select.grit"]
    },
    {
      "includes": ["apps/agent-workplace/web/workplace*.css", "!apps/agent-workplace/web/workplace.css"],
      "plugins": ["./.pi/rules/workplace-palette.grit"]
    }
  ]
}
