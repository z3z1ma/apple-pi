    "pi",
    "pi-coding-agent",
    "questionnaire",
    "pair",
    "compaction",
    "notebook",
    "mcp",
    "organization",
    "interns",
    "ralph",
    "code-review",
    "work-graph"
  ],
  "files": [
    "components/pair-programmer/src/",
    "components/ask-user-question/src/",
    "components/vroom/src/",
    "components/home-search-guard/src/",
    "components/wiki/src/",
    "components/code-context/src/",
    "components/shared/src/",
    "components/session-search/src/",
    "components/notebook/src/",
    "components/interns/src/",
    "components/btw/src/",
    "components/xai-hosted-tools/src/",
    "components/server-compaction/src/",
    "components/notify/src/",
    "components/notify/assets/",
    "components/notify/scripts/",
    "components/notify/LICENSE",
    "components/session-title/src/",
    "components/organization/src/",
    "roles/",
    "components/tmux-sessions/src/",
    "components/tmux-sessions/scripts/",
    "components/tmux-sessions/sidebar/*.py",
    "components/tmux-sessions/notch/NotchShell.swift",
    "components/tmux-sessions/notch/web/",
    "components/tmux-sessions/pi_session_manager.tmux",
    "components/tmux-sessions/LICENSE",
    "components/session-state/src/",
    "components/input-editor/src/",
    "components/tasks/src/",
    "components/session-state/scripts/",
    "components/prompt-stash/src/",
    "components/terse-tools/src/",
    "components/rtk/src/",
    "components/change-reflection/src/",
    "components/pi-exec/src/",
    "components/branch-search/src/",
    "components/browser-pages/src/",
    "components/browser-pages/dist/",
    "apps/agent-world/src/",
    "apps/agent-world/dist/",
    "apps/agent-world/themes/",
    "extensions/",
    "skills/",
    "prompts/",
    "docs/",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-pair.ts",
      "./extensions/ask-user-question.ts",
      "./extensions/session-search.ts",
      "./extensions/auto-compact.ts",
      "./extensions/vroom.ts",
      "./extensions/home-search-guard.ts",
      "./extensions/pi-exec.ts",
      "./extensions/work.ts",
      "./extensions/interns.ts",
      "./extensions/btw.ts",
      "./extensions/ledger.ts",
      "./extensions/wiki.ts",
      "./extensions/code-context.ts",
      "./extensions/xai-hosted-tools.ts",
      "./extensions/server-compaction.ts",
      "./extensions/notify.ts",
      "./extensions/tmux-sessions.ts",
      "./extensions/session-state.ts",
      "./extensions/session-title.ts",
      "./extensions/input-editor.ts",
      "./extensions/tasks.ts",
      "./extensions/prompt-stash.ts",
      "./extensions/terse-tools.ts",
      "./extensions/rtk.ts",
      "./extensions/change-reflection.ts",
      "./extensions/branch-search.ts",
      "./extensions/browser-pages.ts",
      "./extensions/agent-world.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "format": "biome format --write apps components extensions tests scripts docs README.md package.json tsconfig.json vitest.config.ts biome.json tsconfig.web.json",
    "format:check": "biome format apps components extensions tests scripts docs README.md package.json tsconfig.json vitest.config.ts biome.json tsconfig.web.json && uvx ruff format --isolated --check --line-length 120 components/tmux-sessions/sidebar apps/agent-world/art",
    "lint": "biome lint apps components extensions tests scripts && uvx ruff check --isolated --select E4,E7,E9,F --line-length 120 components/tmux-sessions/sidebar apps/agent-world/art",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "build:web": "vite build --config components/browser-pages/web/vite.config.ts --mode code-review && vite build --config components/browser-pages/web/vite.config.ts --mode markdown-review && vite build --config components/browser-pages/web/vite.config.ts --mode ledger-review && vite build --config components/browser-pages/web/vite.config.ts --mode explain-change && cp node_modules/mermaid/dist/mermaid.min.js components/browser-pages/dist/",
    "build:world": "vite build --config apps/agent-world/web/vite.config.ts && vite build --config apps/agent-world/electron.vite.config.ts --mode main && vite build --config apps/agent-world/electron.vite.config.ts --mode preload",
    "check:world-start": "node --import ./components/session-state/src/register.mjs apps/agent-world/scripts/startup-check.ts",
    "test": "npm run test:unit && npm run test:world && npm run test:art && npm run test:sidebar && npm run test:pair && npm run test:loader",
    "test:unit": "vitest run --exclude 'apps/**'",
    "test:world": "vitest run apps --hookTimeout=30000",
    "test:art": "PYTHONDONTWRITEBYTECODE=1 uv run -q --no-project --with pytest --with pillow --with numpy --with scipy pytest -q -p no:cacheprovider apps/agent-world/art/tests",
    "test:sidebar": "PYTHONDONTWRITEBYTECODE=1 uv run -q --no-project --with pytest --with textual==8.2.8 pytest -q -p no:cacheprovider components/tmux-sessions/sidebar/tests",
    "test:pair": "PI_DIST=$PWD/node_modules/@earendil-works/pi-coding-agent/dist node components/pair-programmer/tests/pair.test.mjs",
    "test:loader": "node tests/package-load.mjs",
    "pack:check": "npm pack --dry-run",
    "audit:cache": "node scripts/cache-audit.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.2.0",
    "@earendil-works/pi-ai": ">=1.2.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-tui": ">=1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.2",
    "mermaid": "^11.17.2",
    "phaser": "4.2.1",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typebox": "^1.1.38",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@pydantic/monty": "1.0.0",
    "marked": "^18.1.1",
    "shiki": "^4.5.0"
  }
}
