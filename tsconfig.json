{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "extensions/**/*.ts",
    "components/advisor/src/**/*.ts",
    "components/ask-user-question/src/**/*.ts",
    "components/backlog/src/**/*.ts",
    "components/backlog/tests/**/*.ts",
    "components/shared/src/**/*.ts",
    "components/session-search/src/**/*.ts",
    "components/memory/src/**/*.ts",
    "components/subagents/src/**/*.ts",
    "components/xai-hosted-tools/src/**/*.ts",
    "components/xai-context-compaction/src/**/*.ts",
    "components/notify/src/**/*.ts",
    "components/notify/tests/**/*.ts",
    "components/tmux-sessions/src/**/*.ts",
    "components/tmux-sessions/tests/**/*.ts",
    "components/status-footer/src/**/*.ts",
    "components/status-footer/tests/**/*.ts",
    "components/todos/src/**/*.ts",
    "components/todos/tests/**/*.ts"
  ]
}
