#!/usr/bin/env bash
# Extract one Work Item from a Ledger implementation plan.
# Usage: task-brief PLAN_FILE WI_ID [OUTFILE]
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE WI_ID [OUTFILE]" >&2
  exit 2
fi

plan=$1
wi=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
case "$wi" in
  WI-[0-9][0-9][0-9]) ;;
  [0-9]|[0-9][0-9]|[0-9][0-9][0-9]) wi=$(printf 'WI-%03d' "$wi") ;;
  *) echo "WI_ID must be WI-### or a number: $wi" >&2; exit 2 ;;
esac

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/${wi}-brief.md"
fi

awk -v wi="$wi" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+WI-[0-9][0-9][0-9]([^0-9]|$)/ {
    initem = ($0 ~ ("^#+[ \t]+" wi "([^0-9]|$)"))
  }
  initem { print }
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "${wi} not found in ${plan}" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
