{
  "comments": "forbid",
  "rules": [
    {
      "grit": "response-time-window.grit",
      "message": "Conjoin a nonnegative timestamp ordering check with the response-gap upper bound; live receipt clocks can move backward.",
      "includes": ["apps/agent-workplace/web/overlay/conversation/transcript.tsx"],
      "fires": "if (entry.at - previous.at < GROUP_MS) entries.push(entry);",
      "passes": "if (previous && sameDay && entry.at >= previous.at && entry.at - previous.at < GROUP_MS && entry.id !== firstUnread) entries.push(entry);"
    },
    {
      "grit": "tmux-literal-name.grit",
      "message": "Use tmux character expansion for name hashes to preserve style-shaped text and balanced format delimiters.",
      "includes": ["components/session-state/src/tmux.ts"],
      "fires": "const argument = name.replaceAll(\"#\", \"##\");",
      "passes": "const argument = name.replaceAll(\"#\", \"#{a:35}\");"
    },
    {
      "grit": "hot-bounded-io.grit",
      "message": "Hot paths use bounded file reads and asynchronous child processes; keep whole-file reads and synchronous subprocesses outside .hot.ts modules.",
      "includes": ["**/*.hot.ts"],
      "fires": "import { readFileSync } from \"node:fs\";\nexport const load = (path: string) => readFileSync(path, \"utf8\");\n",
      "passes": "import { open } from \"node:fs/promises\";\nexport const load = (path: string) => open(path, \"r\");\n"
    },
    {
      "grit": "no-native-select.grit",
      "message": "Use Select or Recipients from workplace-fields.tsx; native dropdowns look out of place in Workplace (operator, 2026-11-02).",
      "includes": ["apps/agent-workplace/web/workplace*.tsx"],
      "fires": "export const Picker = () => <select value=\"a\"><option>a</option></select>;\n",
      "passes": "export const Picker = () => <Select value=\"a\" options={[]} />;\n"
    },
    {
      "grit": "workplace-palette.grit",
      "message": "Use a --wp-* theme variable: a hard-coded color does not follow the theme (lint/README.md).",
      "includes": ["apps/agent-workplace/web/workplace*.css", "!apps/agent-workplace/web/workplace.css"],
      "fires": ".badge {\n  color: #3b82f6;\n}\n",
      "passes": ".badge {\n  color: var(--wp-accent);\n  background: #fff;\n}\n"
    }
  ],
  "actions": [
    {
      "id": "bsd-sed-in-place",
      "pattern": "\\bsed\\s+(-[a-zA-Z]*\\s+)*-i\\s*''",
      "reason": "sed here is GNU sed, so `sed -i ''` fails. Use the edit tool.",
      "fires": "sed -i '' 's/a/b/' file.txt",
      "passes": "sed -n '1,5p' file.txt"
    },
    {
      "id": "git-rm-mv",
      "pattern": "\\bgit\\s+(rm|mv)\\b",
      "reason": "`git rm` and `git mv` stage at once, so the change rides along in someone else's commit in this shared checkout. Use plain rm or mv and stage the change with the commit it belongs to.",
      "fires": "git mv old.ts new.ts",
      "passes": "git status --short"
    },
    {
      "id": "kill-by-pattern",
      "pattern": "\\b(pkill|killall)\\b",
      "reason": "Killing by pattern can stop other lanes' runs in this shared checkout. Kill only PIDs you started, or cancel your own background task.",
      "fires": "pkill -f vitest",
      "passes": "kill 12345"
    },
    {
      "id": "full-test-suite",
      "pattern": "(^|[;&|]\\s*)npm\\s+(run\\s+)?test\\s*($|[;&|])",
      "reason": "Full-suite runs need an explicit operator request and overload this machine. Run the test files relevant to the change with --maxWorkers=1.",
      "fires": "npm test",
      "passes": "npx vitest run components/repo-rules --maxWorkers=1"
    },
    {
      "id": "github-writes",
      "pattern": "\\bgit\\s+push\\b|\\bgh\\s+(pr|issue)\\s+(comment|close|reopen|merge|review|edit|create)\\b",
      "reason": "The gh account on this machine is an Enterprise Managed User with pull-only access to this repository: pushes, comments and pull request changes fail. Leave pushes to the operator, and write a comment or closing note to a file for him to post.",
      "fires": "gh pr comment 3 --body-file /tmp/comment.md",
      "passes": "gh pr view 3 --json title"
    }
  ],
  "scripts": [
    {
      "id": "thread-reading-position",
      "on": "edit",
      "script": "thread-reading-position.js",
      "includes": ["apps/agent-workplace/web/workplace-thread.tsx"],
      "fires": [
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "const followLatest = useRef(!!channel);"
        },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "const followLatest = useRef<boolean>(!!channel);"
        },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "const followLatest = useRef<boolean>(\n!!channel\n);"
        },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "<input aria-label=\"Message page size\" aria-disabled={pending} />"
        },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "<input aria-label=\"Message page size\" data-disabled={pending} />"
        },
        { "path": "apps/agent-workplace/web/workplace-thread.tsx", "content": "followLatest.current = !!channel;" },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "<input aria-label=\"Message page size\" onChange={change} />"
        },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "<input type=\"number\" aria-label=\"Message page size\" onChange={change} />"
        },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "<input disabled={pending && unresolved} type=\"number\" aria-label=\"Message page size\" />"
        }
      ],
      "passes": [
        { "path": "apps/agent-workplace/web/workplace-thread.tsx", "content": "const followLatest = useRef(true);" },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "const followLatest = useRef<boolean>(true);"
        },
        { "path": "apps/agent-workplace/web/workplace-thread.tsx", "content": "followLatest.current = true;" },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "const hasNew = !!channel && channel.lastSeq > latestSeq;"
        },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "<input aria-label=\"Message page size\" disabled={pending} onChange={change} />"
        },
        {
          "path": "apps/agent-workplace/web/workplace-thread.tsx",
          "content": "<input disabled={pending || unresolved} type=\"number\" aria-label=\"Message page size\" onChange={change} />"
        }
      ]
    },
    {
      "id": "workplace-wiki-policy",
      "on": "edit",
      "script": "workplace-wiki-policy.js",
      "includes": ["apps/agent-workplace/src/backend/knowledge.ts"],
      "fires": [
        {
          "path": "apps/agent-workplace/src/backend/knowledge.ts",
          "content": "const graph = await loadWikiGraph(root);"
        }
      ],
      "passes": [
        {
          "path": "apps/agent-workplace/src/backend/knowledge.ts",
          "content": "const graph = await loadWikiGraph(root, undefined, includePath);"
        }
      ]
    },
    {
      "id": "git-action-root",
      "on": "edit",
      "script": "git-action-root.js",
      "includes": ["apps/agent-workplace/web/workplace-git.tsx"],
      "fires": [
        {
          "path": "apps/agent-workplace/web/workplace-git.tsx",
          "content": "gitApi().run({ root: rootRef.current, action });"
        }
      ],
      "passes": [{ "path": "apps/agent-workplace/web/workplace-git.tsx", "content": "gitApi().run({ root, action });" }]
    },
    {
      "id": "parallel-dependents",
      "on": "call",
      "script": "parallel-dependents.js",
      "fires": [
        { "tool": "read", "input": { "path": "a.ts" }, "batch": [{ "tool": "edit", "input": { "path": "a.ts" } }] },
        {
          "tool": "bash",
          "input": { "command": "npx biome check a.ts" },
          "batch": [{ "tool": "write", "input": { "path": "./a.ts" } }]
        },
        { "tool": "edit", "input": { "path": "a.ts" }, "batch": [{ "tool": "write", "input": { "path": "a.ts" } }] }
      ],
      "passes": [
        { "tool": "read", "input": { "path": "b.ts" }, "batch": [{ "tool": "edit", "input": { "path": "a.ts" } }] },
        {
          "tool": "bash",
          "input": { "command": "npx biome check $FILE a.ts" },
          "batch": [{ "tool": "edit", "input": { "path": "a.ts" } }]
        },
        { "tool": "read", "input": { "path": "a.ts" }, "batch": [{ "tool": "read", "input": { "path": "a.ts" } }] }
      ]
    },
    {
      "id": "commit-beside-edit",
      "on": "call",
      "script": "commit-beside-edit.js",
      "message": "This message also edits files, and parallel calls run concurrently, so this commit would take the files before the edits land. Commit in a later message.",
      "fires": [
        {
          "tool": "bash",
          "input": { "command": "git add a.ts && git commit -m fix" },
          "batch": [{ "tool": "edit", "input": { "path": "a.ts" } }]
        }
      ],
      "passes": [
        { "tool": "bash", "input": { "command": "git commit -m fix -- a.ts" } },
        {
          "tool": "bash",
          "input": { "command": "git status" },
          "batch": [{ "tool": "edit", "input": { "path": "a.ts" } }]
        }
      ]
    }
  ]
}
